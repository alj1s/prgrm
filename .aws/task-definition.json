{
  "family": "prgrm",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::186266638322:role/service-role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::186266638322:role/prgrm-task-role",
  "containerDefinitions": [
    {
      "name": "prgrm",
      "image": "186266638322.dkr.ecr.us-east-2.amazonaws.com/prgrm:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "BETTER_AUTH_URL",
          "value": "https://prgrm.fitness"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:ssm:us-east-2:186266638322:parameter/prgrm/DATABASE_URL"
        },
        {
          "name": "BETTER_AUTH_SECRET",
          "valueFrom": "arn:aws:ssm:us-east-2:186266638322:parameter/prgrm/BETTER_AUTH_SECRET"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/prgrm",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:3000/ || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      }
    }
  ]
}
